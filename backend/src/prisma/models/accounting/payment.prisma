model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  amount          Decimal       @db.Decimal(15, 2)
  paymentMethod   PaymentMethod
  paymentDate     DateTime
  reference       String?
  mpesaCode       String?
  notes           String?
  createdAt       DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}