// ============================================
// UPDATED PRISMA SCHEMA - Fixed Relations
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS (UPDATED)
// ============================================

enum ProductType {
  GOOD
  SERVICE
  CONSUMABLE
  STORABLE // Added for reporting
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
  COMPLETED // Added for orders.service.ts
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
  PARTIALLY_PAID // Added for reporting
}

enum PaymentMethod {
  CASH
  MPESA
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum BillStatus {
  DRAFT
  SUBMITTED // Added for bills.service.ts
  RECEIVED
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
  PARTIALLY_PAID // Added for reporting
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum StockMovementType { // Changed from MovementType
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ProductionOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED // Added for payroll.service.ts
  PROCESSED
  PAID
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// CORE MODELS (UPDATED)
// ============================================

model Company {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  kraPin    String?
  currency  String   @default("KES") // Added for auth.service.ts
  timezone  String   @default("Africa/Nairobi") // Added for auth.service.ts
  logo      String?  // Added for auth.service.ts
  isActive  Boolean  @default(true) // Added for auth.service.ts
  settings  Json?    // Added for auth.service.ts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users              User[]
  customers          Customer[]
  suppliers          Supplier[]
  products           Product[]
  productCategories  ProductCategory[]
  warehouses         Warehouse[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  quotations         Quotation[]
  salesOrders        SalesOrder[]
  invoices           Invoice[]
  payments           Payment[]
  purchaseOrders     PurchaseOrder[]
  bills              Bill[]
  posSessions        PosSession[]
  boms               BillOfMaterials[]
  productionOrders   ProductionOrder[]
  employees          Employee[]
  stockMovements     StockMovement[]
  stockAdjustments   StockAdjustment[]
  roles              Role[]
  auditLogs          AuditLog[]
  tenantModules      TenantModule[]

  @@unique([name])
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?  // Added for auth.service.ts
  isActive      Boolean  @default(true)
  companyId     String
  refreshToken  String?
  lastLoginAt   DateTime? // Added for auth.service.ts
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles        UserRole[]
  auditLogs    AuditLog[]
  posSessions  PosSession[]      // Added for pos sessions
  stockAdjustments StockAdjustment[] // Added for inventory
  journalEntries JournalEntry[]  // Added for accounting

  @@unique([companyId, email]) // Added for users.service.ts
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean  @default(false) // Added for auth.service.ts
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, name])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   // Added for roles.service.ts
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model TenantModule {
  id          String   @id @default(uuid())
  companyId   String
  module      String
  moduleCode  String   // Added for auth.service.ts
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, module])
  @@unique([companyId, moduleCode]) // Added for auth.service.ts
}

// ============================================
// SALES MODELS (UPDATED)
// ============================================

model Customer {
  id          String   @id @default(uuid())
  code        String   // Added for customers.service.ts
  name        String
  email       String?
  phone       String?
  address     String?
  kraPin      String?
  balance     Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true) // Added for customers.service.ts
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations   Quotation[]
  salesOrders  SalesOrder[]
  invoices     Invoice[]
  payments     Payment[]
  posSales     PosSale[]     // Added for POS

  @@unique([companyId, code]) // Added for customers.service.ts
}

model Quotation {
  id             String          @id @default(uuid())
  quotationNumber String
  customerId     String
  date           DateTime        @default(now())
  validUntil     DateTime        // Added for quotations.service.ts
  expiryDate     DateTime
  status         QuotationStatus @default(DRAFT)
  subtotal       Decimal         @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(15, 2)
  total          Decimal         @default(0) @db.Decimal(15, 2)
  notes          String?
  companyId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id])
  lines    QuotationLine[]

  @@unique([companyId, quotationNumber])
}

model QuotationLine {
  id           String  @id @default(uuid())
  quotationId  String
  productId    String
  description  String?
  quantity     Decimal @db.Decimal(15, 2)
  unitPrice    Decimal @db.Decimal(15, 2)
  taxRate      Decimal @db.Decimal(5, 2)
  amount       Decimal @db.Decimal(15, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id              String           @id @default(uuid())
  orderNumber     String
  customerId      String
  date            DateTime         @default(now())
  expectedDate    DateTime?        // Added for orders.service.ts
  deliveryDate    DateTime?
  status          SalesOrderStatus @default(DRAFT)
  subtotal        Decimal          @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal          @default(0) @db.Decimal(15, 2)
  total           Decimal          @default(0) @db.Decimal(15, 2)
  notes           String?
  companyId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id])
  lines    SalesOrderLine[]
  invoices Invoice[]        // Added for invoices.service.ts

  @@unique([companyId, orderNumber])
}

model SalesOrderLine {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  description String?
  quantity    Decimal @db.Decimal(15, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(15, 2)

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String
  customerId     String
  date           DateTime      @default(now())
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(15, 2)
  total          Decimal       @default(0) @db.Decimal(15, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(15, 2)
  notes          String?
  companyId      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id])
  lines      InvoiceLine[]
  payments   Payment[]
  salesOrder SalesOrder?   @relation(fields: [salesOrderId], references: [id]) // Added for invoices.service.ts
  salesOrderId String?     // Added for invoices.service.ts

  @@unique([companyId, invoiceNumber])
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  productId   String
  description String?
  quantity    Decimal @db.Decimal(15, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(15, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String?
  customerId    String
  amount        Decimal       @db.Decimal(15, 2)
  method        PaymentMethod
  reference     String?
  mpesaCode     String?
  date          DateTime      @default(now())
  notes         String?
  companyId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id])
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id])
}

// ============================================
// PROCUREMENT MODELS (UPDATED)
// ============================================

model Supplier {
  id        String   @id @default(uuid())
  code      String   // Added for suppliers.service.ts
  name      String
  email     String?
  phone     String?
  address   String?
  kraPin    String?
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  isActive  Boolean  @default(true) // Added for suppliers.service.ts
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  bills          Bill[]

  @@unique([companyId, code]) // Added for suppliers.service.ts
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  orderNumber     String
  supplierId      String
  date            DateTime            @default(now())
  expectedDate    DateTime?
  status          PurchaseOrderStatus @default(DRAFT)
  subtotal        Decimal             @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(15, 2)
  total           Decimal             @default(0) @db.Decimal(15, 2)
  notes           String?
  companyId       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier           @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  bills    Bill[]             // Added for bills.service.ts

  @@unique([companyId, orderNumber])
}

model PurchaseOrderLine {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  description String?
  quantity    Decimal @db.Decimal(15, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(15, 2)

  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
}

model Bill {
  id              String     @id @default(uuid())
  billNumber      String
  supplierId      String
  purchaseOrderId String?    // Added for bills.service.ts
  date            DateTime   @default(now())
  dueDate         DateTime
  status          BillStatus @default(DRAFT)
  subtotal        Decimal    @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal    @default(0) @db.Decimal(15, 2)
  total           Decimal    @default(0) @db.Decimal(15, 2)
  paidAmount      Decimal    @default(0) @db.Decimal(15, 2)
  notes           String?
  companyId       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier   @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id]) // Added for bills.service.ts
  lines         BillLine[]

  @@unique([companyId, billNumber])
}

model BillLine {
  id          String  @id @default(uuid())
  billId      String
  productId   String
  description String?
  quantity    Decimal @db.Decimal(15, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(15, 2)

  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ============================================
// INVENTORY MODELS (UPDATED)
// ============================================

model ProductCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, name])
}

model Product {
  id              String      @id @default(uuid())
  sku             String      @map("code") // This maps 'sku' field to 'code' column in DB
  name            String
  description     String?
  type            ProductType @default(GOOD)
  categoryId      String?
  costPrice       Decimal     @db.Decimal(15, 2) @map("unitPrice") // Maps costPrice to unitPrice column
  sellingPrice    Decimal     @db.Decimal(15, 2) @map("salePrice") // Maps sellingPrice to salePrice column
  barcode         String?
  taxRate         Decimal     @default(16) @db.Decimal(5, 2)
  reorderLevel    Decimal?    @db.Decimal(15, 2)
  reorderQuantity Decimal?    @db.Decimal(15, 2) @map("reorderQty") // Maps reorderQuantity to reorderQty column
  trackInventory  Boolean     @default(true)
  isActive        Boolean     @default(true)
  image           String?
  companyId       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category          ProductCategory?    @relation(fields: [categoryId], references: [id])
  stock             Stock[]
  stockMovements    StockMovement[]
  stockAdjustments  StockAdjustment[]
  quotationLines    QuotationLine[]
  salesOrderLines   SalesOrderLine[]
  invoiceLines      InvoiceLine[]
  purchaseOrderLines PurchaseOrderLine[]
  billLines         BillLine[]
  posSaleLines      PosSaleLine[]
  bomComponents     BomComponent[]
  boms              BillOfMaterials[]

  @@unique([companyId, sku]) // Changed from 'code' to 'sku'
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String
  name      String
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stock            Stock[]
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  productionOrders ProductionOrder[]

  @@unique([companyId, code])
}

model Stock {
  productId        String
  warehouseId      String
  quantity         Decimal @default(0) @db.Decimal(15, 2)
  reservedQuantity Decimal @default(0) @db.Decimal(15, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  warehouseId String
  type        StockMovementType // Changed from MovementType
  quantity    Decimal      @db.Decimal(15, 2)
  reference   String?
  notes       String?
  date        DateTime     @default(now())
  companyId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

model StockAdjustment {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  oldQuantity Decimal  @db.Decimal(15, 2)
  newQuantity Decimal  @db.Decimal(15, 2)
  difference  Decimal  @db.Decimal(15, 2)
  reason      String
  notes       String?
  adjustedBy  String
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  adjustedByUser User?   @relation(fields: [adjustedBy], references: [id]) // Added for adjustments.service.ts

  @@unique([productId, warehouseId, createdAt])
}

// ============================================
// ACCOUNTING MODELS (UPDATED)
// ============================================

model Account {
  id            String      @id @default(uuid())
  code          String
  name          String
  type          AccountType
  parentId      String?
  balance       Decimal     @default(0) @db.Decimal(15, 2)
  isActive      Boolean     @default(true)
  companyId     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       Account?       @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]      @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([companyId, code])
}

model JournalEntry {
  id          String             @id @default(uuid())
  entryNumber String
  date        DateTime           @default(now())
  reference   String?
  description String?
  status      JournalEntryStatus @default(DRAFT)
  postedAt    DateTime?          // Added for journal-entries.service.ts
  createdBy   String             // Added for journal-entries.service.ts
  companyId   String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator    User?         @relation(fields: [createdBy], references: [id]) // Added for journal-entries.service.ts
  lines      JournalLine[]

  @@unique([companyId, entryNumber])
}

model JournalLine {
  id        String  @id @default(uuid())
  entryId   String
  accountId String
  debit     Decimal @default(0) @db.Decimal(15, 2)
  credit    Decimal @default(0) @db.Decimal(15, 2)
  notes     String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])
}

// ============================================
// POS MODELS (UPDATED)
// ============================================

model PosSession {
  id            String           @id @default(uuid())
  sessionNumber String
  userId        String           // Added for sessions.service.ts
  openedAt      DateTime         @default(now())
  closedAt      DateTime?
  openingCash   Decimal          @db.Decimal(15, 2)
  closingCash   Decimal?         @db.Decimal(15, 2)
  totalSales    Decimal?         @db.Decimal(15, 2) // Added for sessions.service.ts
  status        PosSessionStatus @default(OPEN)
  companyId     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id]) // Added for sessions.service.ts
  sales   PosSale[]

  @@unique([companyId, sessionNumber])
}

model PosSale {
  id            String        @id @default(uuid())
  saleNumber    String
  sessionId     String
  customerId    String?
  date          DateTime      @default(now()) // Added for sales.service.ts
  subtotal      Decimal       @db.Decimal(15, 2)
  taxAmount     Decimal       @db.Decimal(15, 2)
  total         Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod
  mpesaCode     String?
  companyId     String        // Added for sales.service.ts
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  session  PosSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id]) // Made optional
  lines    PosSaleLine[]

  @@unique([companyId, saleNumber])
}

model PosSaleLine {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(15, 2)
  unitPrice Decimal @db.Decimal(15, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  amount    Decimal @db.Decimal(15, 2)

  sale    PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ============================================
// MANUFACTURING MODELS (UPDATED)
// ============================================

model BillOfMaterials {
  id          String   @id @default(uuid())
  bomNumber   String
  productId   String
  version     String   @default("1.0")
  isActive    Boolean  @default(true)
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  components       BomComponent[]
  productionOrders ProductionOrder[]

  @@unique([companyId, bomNumber])
}

model BomComponent {
  id                 String  @id @default(uuid())
  bomId              String
  productId          String
  quantity           Decimal @db.Decimal(15, 2)
  unit               String?
  wastagePercentage  Decimal @default(0) @db.Decimal(5, 2)

  bom     BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
}

model ProductionOrder {
  id                String                @id @default(uuid())
  orderNumber       String
  bomId             String
  productId         String                // Added for production-orders.service.ts (renamed from finishedProductId)
  plannedQuantity   Decimal               @db.Decimal(15, 2)
  producedQuantity  Decimal               @default(0) @db.Decimal(15, 2)
  scheduledDate     DateTime              // Added for production-orders.service.ts (renamed from plannedDate)
  completedDate     DateTime?
  warehouseId       String                // Added for production-orders.service.ts (renamed from destinationWarehouseId)
  status            ProductionOrderStatus @default(DRAFT)
  notes             String?
  companyId         String
  confirmedAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bom       BillOfMaterials @relation(fields: [bomId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, orderNumber])
}

// ============================================
// HR MODELS (UPDATED)
// ============================================

model Employee {
  id          String    @id @default(uuid())
  employeeNo  String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  kraPin      String?
  nssf        String?
  nhif        String?
  position    String?
  department  String?
  salary      Decimal   @db.Decimal(15, 2)
  hireDate    DateTime
  status      String?   @default("ACTIVE") // Added for reporting.service.ts
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollRuns  PayrollRun[]
  leaveRecords LeaveRecord[]

  @@unique([companyId, employeeNo])
}

model PayrollRun {
  id           String        @id @default(uuid())
  employeeId   String
  periodStart  DateTime
  periodEnd    DateTime
  basicSalary  Decimal       @db.Decimal(15, 2)
  allowances   Decimal       @default(0) @db.Decimal(15, 2)
  grossPay     Decimal       @db.Decimal(15, 2)
  paye         Decimal       @db.Decimal(15, 2)
  nhif         Decimal       @db.Decimal(15, 2)
  nssf         Decimal       @db.Decimal(15, 2)
  deductions   Decimal       @default(0) @db.Decimal(15, 2)
  netPay       Decimal       @db.Decimal(15, 2)
  status       PayrollStatus @default(DRAFT)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveRecord {
  id         String      @id @default(uuid())
  employeeId String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============================================
// AUDIT MODEL (UPDATED)
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  action     String
  entity     String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}